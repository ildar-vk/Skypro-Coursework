# Файл с шаблоном переменных окружения

# Alpha Vantage API для акций (бесплатный ключ: https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# ExchangeRate API для валют (бесплатно, без ключа)
# или можно использовать другой API с ключом
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here

# Другие API ключи по необходимости
FINNHUB_API_KEY=your_finnhub_api_key_here